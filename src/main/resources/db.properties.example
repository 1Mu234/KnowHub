# =========================================================
# KnowHub 数据库配置（模板）
# 使用方法：复制本文件为 db.properties，填入你的数据库密码
# dao.impl=mock  -> 内存 MockDAO（无需数据库）
# dao.impl=jdbc  -> MySQL 8.x
# =========================================================
dao.impl=jdbc

db.driver=com.mysql.cj.jdbc.Driver
db.url=jdbc:mysql://localhost:3306/knowhub?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
db.username=root
db.password=你的数据库密码

db.pool.minIdle=2
db.pool.maxPoolSize=10
db.pool.connectionTimeout=30000
