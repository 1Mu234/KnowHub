<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<c:if test="${sessionScope.loginUser == null}"><c:redirect url="/login.jsp"/></c:if>
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${pageTitle} - KnowHub</title>
    <style>
        :root{
            --primary:#4f46e5; --primary-hover:#4338ca; --primary-light:#eef2ff;
            --bg:#f1f5f9; --card:#fff; --text:#1e293b; --muted:#64748b;
            --border:#e2e8f0; --danger:#ef4444; --radius:10px;
        }
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--text);font-size:14px;line-height:1.6}
        .layout{display:flex;min-height:100vh}
        /* ---------- 侧边栏 ---------- */
        .sidebar{width:230px;background:#fff;border-right:1px solid var(--border);position:sticky;top:0;height:100vh;display:flex;flex-direction:column;flex-shrink:0}
        .brand{padding:20px 24px;font-size:19px;font-weight:700;color:var(--primary);border-bottom:1px solid var(--border);letter-spacing:.5px}
        .brand small{display:block;font-size:11px;color:var(--muted);font-weight:400;margin-top:2px;letter-spacing:0}
        .nav{flex:1;padding:14px 10px;overflow-y:auto}
        .nav a{display:flex;align-items:center;gap:10px;padding:10px 14px;margin-bottom:4px;border-radius:8px;color:var(--muted);text-decoration:none;font-weight:500;transition:all .15s}
        .nav a:hover{background:var(--primary-light);color:var(--primary)}
        .nav a.active{background:var(--primary);color:#fff;box-shadow:0 2px 6px rgba(79,70,229,.3)}
        .nav .icon{width:18px;text-align:center;font-size:15px}
        /* ---------- 顶栏 ---------- */
        .main{flex:1;display:flex;flex-direction:column;min-width:0}
        .topbar{background:#fff;border-bottom:1px solid var(--border);padding:14px 28px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:10}
        .topbar .title{font-size:16px;font-weight:600}
        .user{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:6px}
        .user .avatar{width:28px;height:28px;border-radius:50%;background:var(--primary);color:#fff;display:inline-flex;align-items:center;justify-content:center;font-size:13px;font-weight:600}
        .user a{color:var(--danger);text-decoration:none;margin-left:10px;font-size:13px}
        .user a:hover{text-decoration:underline}
        /* ---------- 内容区 ---------- */
        .content{padding:26px 28px;width:100%;max-width:1200px}
        .card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:22px 24px;box-shadow:0 1px 3px rgba(15,23,42,.05);margin-bottom:20px}
        .card h3{font-size:15px;margin-bottom:14px;color:var(--text)}
        /* ---------- 控件 ---------- */
        .btn{display:inline-block;padding:8px 16px;border-radius:8px;font-size:13px;font-weight:500;border:0;cursor:pointer;text-decoration:none;transition:all .15s}
        .btn-primary{background:var(--primary);color:#fff}
        .btn-primary:hover{background:var(--primary-hover)}
        .btn-danger{background:#fee2e2;color:var(--danger)}
        .btn-danger:hover{background:#fecaca}
        .btn-ghost{background:#f1f5f9;color:var(--text)}
        .btn-ghost:hover{background:#e2e8f0}
        table{width:100%;border-collapse:collapse;font-size:13px}
        th{background:#f8fafc;color:var(--muted);font-weight:600;text-align:left;padding:10px 12px;border-bottom:1px solid var(--border);white-space:nowrap}
        td{padding:11px 12px;border-bottom:1px solid var(--border);vertical-align:top}
        tbody tr:hover td{background:#f8fafc}
        input[type=text],input[type=password],select,textarea{width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;font-size:14px;font-family:inherit;background:#fff;transition:all .15s}
        input:focus,select:focus,textarea:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 3px rgba(79,70,229,.12)}
        input[type=file]{width:100%;padding:10px;border:1.5px dashed var(--border);border-radius:8px;font-size:13px;background:#f8fafc;cursor:pointer}
        label{display:block;margin-bottom:6px;font-weight:500;font-size:13px}
        .form-item{margin-bottom:16px}
        .msg{color:var(--danger);font-size:13px;margin-bottom:12px}
        .empty{text-align:center;color:var(--muted);padding:40px 0}
        .badge{display:inline-block;padding:2px 10px;border-radius:999px;background:var(--primary-light);color:var(--primary);font-size:12px}
        .hint{font-size:12px;color:var(--muted);margin-top:6px}
        mark{background:#fef08a;color:#713f12;padding:0 2px;border-radius:3px;font-weight:500}
        .flex-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
    </style>
</head>
<body>
<div class="layout">
    <aside class="sidebar">
        <div class="brand">📚 KnowHub<small>智能知识库系统</small></div>
        <nav class="nav">
            <a href="${pageContext.request.contextPath}/index.jsp" class="${menu=='home'?'active':''}"><span class="icon">🏠</span>首页</a>
            <c:if test="${sessionScope.loginUser.fullAccess}">
                <a href="${pageContext.request.contextPath}/category" class="${menu=='category'?'active':''}"><span class="icon">🗂️</span>分类管理</a>
                <a href="${pageContext.request.contextPath}/upload" class="${menu=='upload'?'active':''}"><span class="icon">📤</span>文档上传</a>
                <a href="${pageContext.request.contextPath}/document" class="${menu=='document'?'active':''}"><span class="icon">📋</span>文档列表</a>
            </c:if>
            <a href="${pageContext.request.contextPath}/search" class="${menu=='search'?'active':''}"><span class="icon">🔍</span>知识库检索</a>
            <a href="${pageContext.request.contextPath}/qa" class="${menu=='qa'?'active':''}"><span class="icon">🤖</span>智能问答</a>
            <a href="${pageContext.request.contextPath}/qa?view=history" class="${menu=='history'?'active':''}"><span class="icon">📜</span>问答历史</a>
            <a href="${pageContext.request.contextPath}/settings" class="${menu=='settings'?'active':''}"><span class="icon">⚙️</span>API 设置</a>
            <c:if test="${sessionScope.loginUser.role == 'admin'}">
                <a href="${pageContext.request.contextPath}/admin/user" class="${menu=='admin'?'active':''}"><span class="icon">👥</span>用户审批</a>
            </c:if>
        </nav>
    </aside>
    <div class="main">
        <div class="topbar">
            <div class="title">${pageTitle}</div>
            <div class="user">
                <span class="avatar">${sessionScope.loginUser.nickname.substring(0,1)}</span>
                <span>${sessionScope.loginUser.nickname}<span class="badge" style="margin-left:4px">${sessionScope.loginUser.role}</span></span>
                <a href="${pageContext.request.contextPath}/login?action=logout">退出登录</a>
            </div>
        </div>
        <div class="content">
